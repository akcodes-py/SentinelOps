# Copy to .env. All values are safe local defaults — no real secrets.
SENTINEL_MODE=defended                 # baseline | defended
SENTINEL_DB_URL=sqlite:///./data/sentinel.db
SENTINEL_POLICY_PATH=./policy.yaml
SENTINEL_JWT_SECRET=local-dev-secret-change-me-32bytes!
SENTINEL_JWT_EXPIRY_MINUTES=15
SENTINEL_TRUSTED_PROXIES=127.0.0.1,::1
SENTINEL_LOG_PATH=./logs/sentinel.jsonl
SENTINEL_VECTOR_BACKEND=memory         # memory | chroma
SENTINEL_PII_BACKEND=regex             # regex | presidio
SENTINEL_LLM_BACKEND=mock              # mock | langchain | openai | hf
# Required when SENTINEL_LLM_BACKEND=hf: immutable HF commit SHA (not a branch/tag).
# Find it on https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct -> "Commits".
SENTINEL_HF_REVISION=
SENTINEL_TEMPERATURE=0

# --- Gateway encryption at rest (AES-256-GCM) -----------------------------
# Leave empty to disable encrypted audit storage. When set, it MUST be base64
# of exactly 32 random bytes. Generate a key with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Never commit the generated value. Used only for encrypted audit payloads in
# the encrypted_audit_events table (system prompt / policy.yaml are never keys).
ENCRYPTION_KEY=

# --- HTTPS / TLS -----------------------------------------------------------
# For local TLS, create a self-signed certificate and start uvicorn with it:
#   mkdir certs
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/key.pem -out certs/cert.pem -days 365 -subj "/CN=localhost"
#   uvicorn sentinelops.app.main:app --ssl-keyfile ./certs/key.pem --ssl-certfile ./certs/cert.pem --port 8010
# Behind a TLS-terminating proxy, set require_https and list the proxy in
# SENTINEL_TRUSTED_PROXIES so X-Forwarded-Proto: https is honoured.
SENTINEL_REQUIRE_HTTPS=false            # true rejects plain HTTP (403) in defended mode

# Security headers (Strict-Transport-Security, X-Content-Type-Options,
# X-Frame-Options, Content-Security-Policy, Referrer-Policy) are always sent by
# src/middleware/security_headers.py. See SECURITY_ASSESSMENT.md for OWASP 2026 mapping.
