# Copy to .env. All values are safe local defaults — no real secrets.
SENTINEL_MODE=defended                 # baseline | defended
SENTINEL_DB_URL=sqlite:///./data/sentinel.db
SENTINEL_POLICY_PATH=./policy.yaml
SENTINEL_JWT_SECRET=local-dev-secret-change-me-32bytes!
SENTINEL_JWT_EXPIRY_MINUTES=15
SENTINEL_TRUSTED_PROXIES=127.0.0.1,::1
SENTINEL_LOG_PATH=./logs/sentinel.jsonl
SENTINEL_VECTOR_BACKEND=memory         # memory | chroma
SENTINEL_PII_BACKEND=regex             # regex | presidio
SENTINEL_LLM_BACKEND=mock              # mock | openai | hf
SENTINEL_TEMPERATURE=0
